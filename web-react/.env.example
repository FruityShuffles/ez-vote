# Copy to .env for local dev. Vite only exposes vars prefixed with VITE_ to the
# client, and inlines them at build time — so the values baked into a build are
# whichever ones were present when it ran. Find them in the Supabase dashboard
# under Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
